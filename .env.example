# OpenRouter (free models only) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Signs session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Optional — enables real Reddit reviews on the college detail page.
# Create a "script" app at https://www.reddit.com/prefs/apps
# Without these, the page still shows deep links out to Reddit.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=edubridge/1.0
