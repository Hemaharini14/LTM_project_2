# OpenRouter (free models only) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Signs session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Optional — enables real Reddit reviews on the college detail page.
# Create a "script" app at https://www.reddit.com/prefs/apps
# Without these, the page still shows deep links out to Reddit.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=edubridge/1.0

# Optional — enables real accommodation listings (name, address,
# distance) near a university on its detail page, via Geoapify's
# Places API (free tier). Get one at https://www.geoapify.com/
# Without it, listings fall back to clearly-labelled samples.
GEOAPIFY_API_KEY=

# Optional — enables real round-trip flight price search in the cost
# calculator, via the Ignav Flight API (first 1,000 requests free).
# Get one at https://ignav.com/ . Without it, the flight-cost field
# stays a manually-entered estimate.
IGNAV_API_KEY=
